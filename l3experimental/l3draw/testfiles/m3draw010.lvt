\documentclass{minimal}
\input{regression-test}

\RequirePackage{l3draw}
\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\AUTHOR{Jasper Habicht}

\ExplSyntaxOn

\cs_set_protected:Npn \test:n #1
  {
    \draw_begin:
      \draw_path_circle:nn { ( 0pt , 0pt ) } { 5pt }
      \tl_show:e { #1 }
    \draw_end:
  }

\START

\TEST { \draw_path_xmin: }
  {
    \test:n { \draw_path_xmin: }
  }

\TEST { \draw_path_ymin: }
  {
    \test:n { \draw_path_ymin: }
  }

\TEST { \draw_path_xmax: }
  {
    \test:n { \draw_path_xmax: }
  }

\TEST { \draw_path_ymax: }
  {
    \test:n { \draw_path_ymax: }
  }

\END
