\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}

\START
\AUTHOR{peaR}
\ExplSyntaxOn

\OMIT
\cs_set:Npn \bar { BAR }
\cs_set:Npn \test:w #1 \s_stop { \TYPE { | \exp_not:n {#1} | } }
\cs_set:Npn \test_mean_aux:N #1 { \token_to_meaning:N #1 ; ~ }
\cs_set:Npn \test_mean:w #1 \s_stop
  { \TYPE { \tl_map_function:nN {#1} \test_mean_aux:N } }
\cs_set_protected:Npn \test_regime:nn #1#2
  {
    \cs_set_protected:Npn \test_regime_aux:
      { \group_begin: \char_set_catcode_other:N \\ #1 }
    \tex_scantokens:D { \test_regime_aux: #2 \s_stop }
  }
\TIMO

\TEST { Peek~regex~remove~once~does~not~read~too~far }
  {
    \test_regime:nn
      { \peek_regex_remove_once:nTF { = } { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w } }
      { = \bar }
  }

\TEST { Peek~regex~does~not~read~too~far }
  {
    \test_regime:nn
      { \peek_regex:nTF { = } { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w } }
      { = \bar }
  }

\TEST { Peek~regex~replace~once~does~not~read~too~far }
  {
    \test_regime:nn
      {
        \peek_regex_replace_once:nnTF { = } { X }
          { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w }
      }
      { = \bar }
  }

\TEST { Decide~at~first~success~when~it~has~highest~priority }
  {
    \test_regime:nn
      { \peek_regex_remove_once:nTF { a | a b } { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w } }
      { a \bar }
    \SEPARATOR
    \test_regime:nn
      { \peek_regex_remove_once:nTF { a ?? } { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w } }
      { a \bar }
    \SEPARATOR
    \test_regime:nn
      { \peek_regex_remove_once:nTF { a *? } { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w } }
      { \bar }
    \SEPARATOR
    \test_regime:nn
      { \peek_regex_remove_once:nTF { } { \group_end: \TRUE \test_mean:w } { \group_end: \ERROR \test_mean:w } }
      { \bar }
  }

\TEST { Failure~is~detected~without~reading~more }
  {
    \test_regime:nn
      { \peek_regex_remove_once:nTF { a b } { \group_end: \ERROR \test_mean:w } { \group_end: \FALSE \test_mean:w } }
      { c \bar }
    \SEPARATOR
    \test_regime:nn
      { \peek_regex:nTF { a b } { \group_end: \ERROR \test_mean:w } { \group_end: \FALSE \test_mean:w } }
      { c \bar }
  }

\TEST { Peek~regex~keeps~going~when~needed }
  {
    \peek_regex_remove_once:nTF { a + } { \TRUE \test:w } { \ERROR \test:w } aaab \s_stop
    \peek_regex_remove_once:nTF { a * } { \TRUE \test:w } { \ERROR \test:w } aaab \s_stop
    \peek_regex_remove_once:nTF { [a-c]{2,3} } { \TRUE \test:w } { \ERROR \test:w } abcabc \s_stop
    \peek_regex_remove_once:nTF { a b | a b c } { \TRUE \test:w } { \ERROR \test:w } abcd \s_stop
    \peek_regex_remove_once:nTF { a | a b } { \TRUE \test:w } { \ERROR \test:w } abcd \s_stop
    \peek_regex_remove_once:nTF { a b c | [a-z] } { \TRUE \test:w } { \ERROR \test:w } abcd \s_stop
    \peek_regex_remove_once:nTF { a *? } { \TRUE \test:w } { \ERROR \test:w } aab \s_stop
    \SEPARATOR
    \peek_regex:nTF { a + } { \TRUE \test:w } { \ERROR \test:w } aaab \s_stop
    \peek_regex:nTF { a b c | [a-z] } { \TRUE \test:w } { \ERROR \test:w } abcd \s_stop
    \peek_regex:nTF { a b c | [a-z] } { \ERROR \test:w } { \FALSE \test:w } 1abcd \s_stop
  }

\TEST { Peek~regex~remove~once~reinserts~every~token }
  {
    \peek_regex_remove_once:nTF { a (bc)? } { \TRUE \test:w } { \ERROR \test:w } abd \s_stop
    \peek_regex_remove_once:nTF { a (bc)? } { \TRUE \test:w } { \ERROR \test:w } abcd \s_stop
    \peek_regex_remove_once:nTF { (a{2,3})* } { \TRUE \test:w } { \ERROR \test:w } adada \s_stop
    \peek_regex_remove_once:nTF { ([ab]c[ab]{1,2}bb)? } { \TRUE \test:w } { \ERROR \test:w } aa \s_stop
    \peek_regex_remove_once:nTF { (?:a|c)[bc] \c{x}? } { \TRUE \test:w } { \ERROR \test:w } cb { d } \s_stop
    \peek_regex_remove_once:nTF { a (b|) } { \TRUE \test:w } { \ERROR \test:w } a { b } \s_stop
    \SEPARATOR
    \peek_regex_remove_once:nTF { a b } { \ERROR \test:w } { \FALSE \test:w } a { c } \s_stop
    \peek_regex_remove_once:nTF { a b } { \ERROR \test:w } { \FALSE \test:w } a \s_stop
  }

\TEST { Peek~regex~replace~once~reinserts~every~token }
  {
    \peek_regex_replace_once:nnTF { a (bc)? } { [\0] } { \TRUE \test:w } { \ERROR \test:w } abd \s_stop
    \peek_regex_replace_once:nnTF { a (bc)? } { [\1] } { \TRUE \test:w } { \ERROR \test:w } abcd \s_stop
    \peek_regex_replace_once:nnTF { a+ } { [\0] } { \TRUE \test:w } { \ERROR \test:w } aab \s_stop
  }

\END
