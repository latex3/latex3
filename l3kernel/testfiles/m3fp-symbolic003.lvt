\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{peaR}
\ExplSyntaxOn

\TEST { Simple~symbolic~comparisons }
  {
    \fp_new_variable:n { a }
    \TYPE { \fp_to_tl:n { a < 5 } }
    \TYPE { \fp_to_tl:n { a = 5 } }
    \TYPE { \fp_to_tl:n { a > 5 } }
    \TYPE { \fp_to_tl:n { a <= 5 } }
    \TYPE { \fp_to_tl:n { a >= 5 } }
    \TYPE { \fp_to_tl:n { a != 5 } }
    \TYPE { \fp_to_tl:n { 5 < a } }
    \TYPE { \fp_to_tl:n { 5 = a } }
    \TYPE { \fp_to_tl:n { 5 > a } }
    \TYPE { \fp_to_tl:n { 5 <= a } }
    \TYPE { \fp_to_tl:n { 5 >= a } }
    \TYPE { \fp_to_tl:n { 5 != a } }
  }

\TEST { Slightly~complex~symbolic~comparisons }
  {
    \fp_new_variable:n { b }
    \TYPE { \fp_to_tl:n { a < b } }
    \TYPE { \fp_to_tl:n { a = b } }
    \TYPE { \fp_to_tl:n { a > b } }
    \TYPE { \fp_to_tl:n { a <= b } }
    \TYPE { \fp_to_tl:n { a >= b } }
    \TYPE { \fp_to_tl:n { a != b } }
    \TYPE { \fp_to_tl:n { a + 1 < b * 2 } }
    \TYPE { \fp_to_tl:n { 2 * a < b - 3 } }
  }

\ExplSyntaxOff
\END