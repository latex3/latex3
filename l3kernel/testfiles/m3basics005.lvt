\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{Ruiyuan Chen}
\ExplSyntaxOn

\TEST { prg_new_conditional ~ with ~ leading ~ brace ~ group }
  {
    \prg_new_conditional:Npnn \foo: { TF, T, F, p }
      {
        { \if_true: }
          \prg_return_true:
        \else:
          \prg_return_false:
        \fi:
      }
    \TYPE { \tex_expanded:D \foo:TF { TRUE } { FALSE } }
    \TYPE { \tex_expanded:D \foo:T { TRUE } }
    \TYPE { \tex_expanded:D \foo:F { \use_i:nnnnn { FALSE } } TRUE }
    \TYPE { \if_predicate:w \tex_expanded:D \foo_p: TRUE \else: FALSE \fi: }
  }

\END
