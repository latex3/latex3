\documentclass{minimal}
\input{regression-test}


\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff


\begin{document}
\START
\AUTHOR{Ruiyuan Chen}
\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\OMIT
\prop_new_linked:N \g_a_prop
\prop_gput:Nnn \g_a_prop {mykeya} {myvaluea}
\prop_gput:Nnn \g_a_prop {mykeyb} {myvalueb}
\prop_gput:Nnn \g_a_prop {mykeyc} {myvaluec}
\cs_new_protected:Npn \my_group_begin:
  {
    % Temporary variables that we don't want to trace.
    \tl_clear:N \l_tmpa_tl
    \tl_clear:N \l_tmpb_tl
    \cs_set:Npn \__prop_split_flat:w {}
    \tl_clear:N \l__prop_tmp_tl
    \group_begin:
  }
\cs_new_protected:Npn \my_group_end:
  {
    % Only enable tracing immediately before group end to avoid showing saves
    % that are self-contained within a single function call.
    % Set tracing parameters globally as otherwise they are the first ones
    % restored by the group end.
    \exp_args:Nne \use:nn
      {
        \tex_global:D \tex_tracingonline:D = \c_one_int
        \tex_global:D \tex_tracingrestores:D = \c_one_int
        \group_end:
      }
      {
        \tex_global:D \tex_tracingonline:D
          = \int_use:N \tex_tracingonline:D \exp_stop_f:
        \tex_global:D \tex_tracingrestores:D
          = \int_use:N \tex_tracingrestores:D \exp_stop_f:
      }
  }
\TIMO

\TEST { save~stack~after~get }
  {
    \my_group_begin:
    \prop_get:NnN \g_a_prop {mykeya} \l_tmpa_tl
    \prop_get:NnN \g_a_prop {nokey} \l_tmpb_tl
    \my_group_end:
  }

\TEST { save~stack~after~gpop }
  {
    \my_group_begin:
    \prop_gpop:NnN \g_a_prop {mykeya} \l_tmpa_tl
    \prop_gpop:NnN \g_a_prop {nokey} \l_tmpb_tl
    \my_group_end:
  }

\TEST { save~stack~after~gput }
  {
    \my_group_begin:
    \prop_gput:Nnn \g_a_prop {mykey1} {myvalue1}
    \prop_gput:Nnn \g_a_prop {mykey2} {myvalue2}
    \prop_gput:Nnn \g_a_prop {mykeyb} {myvalue3}
    \my_group_end:
  }

\TEST { save~stack~after~gput_if_not_in }
  {
    \my_group_begin:
    \prop_gput_if_not_in:Nnn \g_a_prop {mykey2} {myvalue2}
    \prop_gput_if_not_in:Nnn \g_a_prop {mykey3} {myvalue3}
    \prop_gput_if_not_in:Nnn \g_a_prop {mykeyb} {myvalue4}
    \my_group_end:
  }

\TEST { save~stack~after~gput_from_keyval }
  {
    \my_group_begin:
    \prop_gput_from_keyval:Nn \g_a_prop
      {
        kvkey1 = kvval1,
        kvkey2 = kvval2,
        kvkey3 = kvval3,
      }
    \my_group_end:
  }

\TEST { save~stack~after~gremove }
  {
    \my_group_begin:
    \prop_gremove:Nn \g_a_prop {kvkey2}
    \prop_gremove:Nn \g_a_prop {mykey2}
    \prop_gremove:Nn \g_a_prop {nokey}
    \my_group_end:
  }

\TEST { save~stack~after~repeated~gput~+~gremove }
  {
    \my_group_begin:
    \prg_replicate:nn { 10 }
      {
        \prop_gput:Nnn \g_a_prop {mykey2} {myvalue2}
        \prop_gremove:Nn \g_a_prop {mykey2}
      }
    \my_group_end:
  }

\END

