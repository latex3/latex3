\begin{document}
\START
\AUTHOR{Joseph Wright, Bruno Le Floch}
\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\TESTEXP { item }
  {
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , 1 ) } \TYPE
    \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , -1 ) } \TYPE
    \NEWLINE
    \fp_eval:n { item ( 2 * ( 1 , 2 , 3 ) , 2 ) } \TYPE
    \NEWLINE
    \fp_eval:n { item ( 1 , 2 , 3 ) } \TYPE
    \NEWLINE
    \fp_eval:n { item ( 1 , 2 ) } \TYPE
    \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , ( 1 , 2 ) ) } \TYPE
    \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , 1.2 ) } \TYPE
    \NEWLINE
  }

\TESTEXP { \fp_if_tuple:n(TF) }
  {
    \fp_if_tuple:nTF { ( 1 , 2 , 3 ) } { \TRUE } { \FALSE } \TYPE
    \NEWLINE
    \fp_if_tuple:nTF { 1 } { \TRUE } { \FALSE } \TYPE
    \NEWLINE
    \bool_if:nTF { \fp_if_tuple_p:n { ( 1 , 2 , 3 ) } } { \TRUE } { \FALSE } \TYPE
    \NEWLINE
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\END
