\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{Jasper Habicht}
\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\TESTEXP { Count-items }
  {
    \fp_to_tl:n { count ( ( 1 , 2 , 3 ) ) } \NEWLINE
  }

\TESTEXP { Select-item }
  {
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , 1 ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , -1 ) } \NEWLINE
    \fp_to_tl:n { item ( 2 * ( 1 , 2 , 3 ) , 2 ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , 2 ) + 1 } \NEWLINE
  }

\TESTEXP { Check-if-tuple }
  {
    \fp_if_tuple:nTF { ( 1 , 2 , 3 ) } { \TRUE } { \FALSE } \NEWLINE
    \fp_if_tuple:nTF { 1 } { \TRUE } { \FALSE } \NEWLINE
    \bool_if:nTF { \fp_if_tuple_p:n { ( 1 , 2 , 3 ) } } { \TRUE } { \FALSE } \NEWLINE
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\TEST { Symbolic-use }
  {
    \fp_new_variable:n { A }
    \fp_set:Nn \l_tmpa_fp { count ( A ) }
    \fp_set_variable:nn { A } { ( 1 , 2 , 3 ) }
    \TYPE
      {
        \fp_to_tl:n { \l_tmpa_fp }
      }

    \fp_new_variable:n { B }
    \fp_set:Nn \l_tmpa_fp { item ( B , 1 ) }
    \fp_set_variable:nn { B } { ( 1 , 2 ) }
    \TYPE
      {
        \fp_to_tl:n { \l_tmpa_fp }
      }

    \fp_new_variable:n { C }
    \fp_set:Nn \l_tmpa_fp { item ( ( C , 2 ) , 1 ) }
    \fp_set_variable:nn { C } { 3 }
    \TYPE
      {
        \fp_to_tl:n { \l_tmpa_fp }
      }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\TESTEXP { Count-with-error }
  {
    \fp_to_tl:n { count ( 1 ) } \NEWLINE
    \fp_to_tl:n { count ( 1 , 2 ) } \NEWLINE
    \fp_to_tl:n { count ( ( 1 , 2 , 3 ) , 1 ) } \NEWLINE
  }

\TESTEXP { Item-with-error }
  {
    \fp_to_tl:n { item ( 1 ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , 1 , 2 ) } \NEWLINE
    \fp_to_tl:n { item ( 1 , 1 ) } \NEWLINE
    \fp_to_tl:n { item ( 1 , ( 1 , 2 ) ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , 1.2 ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , inf ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , nan ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , 0 ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , 4 ) } \NEWLINE
    \fp_to_tl:n { item ( ( 1 , 2 , 3 ) , -4 ) } \NEWLINE
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\END
