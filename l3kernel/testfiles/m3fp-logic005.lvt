\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{Joseph Wright, Bruno Le Floch}
\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\TESTEXP { Select-item }
  {
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , 1 ) } \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , -1 ) } \NEWLINE
    \fp_eval:n { item ( 2 * ( 1 , 2 , 3 ) , 2 ) } \NEWLINE
    \fp_eval:n { item ( 1 , 2 , 3 ) } \NEWLINE
    \fp_eval:n { item ( 1 ) } \NEWLINE
    \fp_eval:n { item ( 1 , 2 ) } \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , ( 1 , 2 ) ) } \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , 1.2 ) } \NEWLINE
  }

\TESTEXP { Select-item-with-errors }
  {
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , 1 ) } \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , -1 ) } \NEWLINE
    \fp_eval:n { item ( 2 * ( 1 , 2 , 3 ) , 2 ) } \NEWLINE
    \fp_eval:n { item ( 1 , 2 , 3 ) } \NEWLINE
    \fp_eval:n { item ( 1 ) } \NEWLINE
    \fp_eval:n { item ( 1 , 2 ) } \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , ( 1 , 2 ) ) } \NEWLINE
    \fp_eval:n { item ( ( 1 , 2 , 3 ) , 1.2 ) } \NEWLINE
  }

\TESTEXP { Check-if-tuple }
  {
    \fp_if_tuple:nTF { ( 1 , 2 , 3 ) } { \TRUE } { \FALSE } \NEWLINE
    \fp_if_tuple:nTF { 1 } { \TRUE } { \FALSE } \NEWLINE
    \bool_if:nTF { \fp_if_tuple_p:n { ( 1 , 2 , 3 ) } } { \TRUE } { \FALSE } \NEWLINE
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\END
