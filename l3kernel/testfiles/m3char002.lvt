%
\documentclass{minimal}
\input{regression-test}
\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{peaR}
\ExplSyntaxOn

% Active character handling, see gh/1796

\OMIT
\group_begin:
  \char_set_catcode_active:N \^^@
  \char_set_lccode:nn { `\^^@ } { `\@ }
  \tex_lowercase:D
    {
      \group_end:
      \cs_new_protected:Npn \test_show:n #1
        { \TYPE { #1 : ~ \token_to_meaning:N ^^@ } }
    }
\cs_new_protected:Npn \test_align:
  { \char_set_active_eq:NN \@ \c_alignment_token }
\TIMO

\TEST { Plain~use~(not~in~an~alignment) }
  {
    \test_align:
    \test_show:n { alignment }
    \char_set_active_eq:NN \@ \prg_do_nothing:
    \test_show:n { NN }
    \test_align:
    \char_set_active_eq:nN { `\@ } \prg_do_nothing:
    \test_show:n { nN }
    \test_align:
    \char_set_active_eq:Nc \@ { prg_do_nothing: }
    \test_show:n { Nc }
    \test_align:
    \char_set_active_eq:nc { 64 } { prg_do_nothing: }
    \test_show:n { nc }
    \test_align:
    \group_begin:
      \char_set_active_eq:NN \@ \prg_do_nothing:
    \group_end:
    \test_show:n { local }
    \group_begin:
      \char_gset_active_eq:NN \@ \prg_do_nothing:
    \group_end:
    \test_show:n { global }
    \test_align:
    \group_begin:
      \char_gset_active_eq:nc { 64 } { prg_do_nothing: }
    \group_end:
    \test_show:n { gset~nc }
    \cs_if_eq:NNTF \g__char_active_token \scan_stop:
      { \TYPE { scratch~token~reset } }
      { \ERROR }
  }

\TEST { Change~inside~\halign }
  {
    \test_align:
    \test_show:n { before }
    \tex_halign:D
      {
        # \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing:
        \test_show:n { in~cell }
        \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\halign:~several~cells~and~rows }
  {
    \test_align:
    \tex_halign:D
      {
        # & # \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing:
        \test_show:n { 1,1 } &
        \test_show:n { 1,2 } \tex_cr:D
        \test_show:n { 2,1 } &
        \char_set_active_eq:nN { `\@ } \prg_do_nothing:
        \test_show:n { 2,2 } \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\halign:~last~token~of~u-template }
  {
    \test_align:
    \tex_halign:D
      {
        \char_set_active_eq:NN \@ \prg_do_nothing: # \tex_cr:D
        \test_show:n { in~cell }
        \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\halign:~last~token~of~v-template }
  {
    \test_align:
    \tex_halign:D
      {
        # \char_set_active_eq:NN \@ \prg_do_nothing: \tex_cr:D
        \test_show:n { in~cell } \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\halign:~global }
  {
    \test_align:
    \tex_halign:D
      {
        # \tex_cr:D
        \char_gset_active_eq:NN \@ \prg_do_nothing:
        \test_show:n { in~cell }
        \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\halign:~followed~directly~by~the~end~of~the~cell }
  {
    \test_align:
    \tex_halign:D
      {
        # & # \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing: &
        \test_show:n { 2 } \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing: \tex_cr:D
        \test_show:n { 3 } &
        \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\valign }
  {
    \test_align:
    \tex_hbox:D
      {
        \tex_valign:D
          {
            # \tex_cr:D
            \char_set_active_eq:NN \@ \prg_do_nothing:
            \test_show:n { in~cell }
            \tex_cr:D
          }
      }
    \test_show:n { after }
  }

\TEST { Change~inside~nested~alignments }
  {
    \test_align:
    \tex_halign:D
      {
        # \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing:
        \test_show:n { outer }
        \tex_vbox:D
          {
            \test_align:
            \tex_halign:D
              {
                # \tex_cr:D
                \char_set_active_eq:NN \@ \prg_do_nothing:
                \test_show:n { inner }
                \tex_cr:D
              }
          }
        \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Change~inside~\noalign }
  {
    \test_align:
    \tex_halign:D
      {
        # \tex_cr:D
        \tex_noalign:D { \char_set_active_eq:NN \@ \prg_do_nothing: }
        \tex_relax:D \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Active~character~equal~to~\cr }
  {
    \char_set_active_eq:NN \@ \tex_cr:D
    \test_show:n { before }
    \tex_halign:D
      {
        # \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing:
        \test_show:n { in~cell }
        \tex_cr:D
      }
    \test_show:n { after }
  }

\TEST { Active~character~equal~to~\span }
  {
    \char_set_active_eq:NN \@ \tex_span:D
    \test_show:n { before }
    \tex_halign:D
      {
        # \tex_cr:D
        \char_set_active_eq:NN \@ \prg_do_nothing:
        \test_show:n { in~cell }
        \tex_cr:D
      }
    \test_show:n { after }
  }

\END
