\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff


\begin{document}
\START
\AUTHOR{Joseph Wright}
\ExplSyntaxOn

\TEST { Augmented~key~setting }
  {
    \OMIT
      \keys_define:nn { test }
        {
          key-one .clist_set:N = \l_tmpa_clist ,
          key-two .dim_set:N = \l_tmpa_dim
        }
    \TIMO
    \keys_set:nn { test } { key-one = a , key-two = 10pt }
    \clist_show:N \l_tmpa_clist
    \dim_show:N \l_tmpa_dim
    \keys_set:nn { test } { key-one += b , key-two += 11pt }
    \clist_show:N \l_tmpa_clist
    \dim_show:N \l_tmpa_dim
    \keys_set:nn { test } { key-one += c , key-two += 12pt }
    \clist_show:N \l_tmpa_clist
    \dim_show:N \l_tmpa_dim
    \keys_set:nn { test } { key-one = a , key-two = 10pt }
    \clist_show:N \l_tmpa_clist
    \dim_show:N \l_tmpa_dim
  }

\TEST { Augmented~key~setting~invalid }
  {
    \OMIT
      \keys_define:nn { test }
        {
          key-one .cs_set:Np = \cs_tmp:w
        }
    \TIMO
    \keys_set:nn { test } { key-one += a }
  }

\TEST { Augmented~key~precompilation }
  {
    \OMIT
      \keys_define:nn { test }
        {
          key-one .clist_set:N = \l_tmpa_clist ,
          key-two .dim_set:N = \l_tmpa_dim
        }
    \TIMO
    \keys_set:nn { test } { key-one = a , key-two = 10pt }
    \keys_precompile:nnN { test } { key-one += b , key-two += 11pt }
      \l_tmpa_tl
    \tl_show:N \l_tmpa_tl
  }

\TEST { Custom~methods }
  {
    \OMIT
      \keys_define:nn { test }
        {
          key-one .code:n = { \tl_set:Nn \l_tmpa_tl {#1} } ,
          key-one .append_method:n
            = { \tl_put_right:Nn \l_tmpa_tl {#1} }
        }
    \TIMO
    \keys_set:nn { test } { key-one = a , key-one += b }
    \tl_show:N \l_tmpa_tl
  }

\END