\documentclass{minimal}
\input{regression-test}

\ExplSyntaxOn
\debug_on:n { check-declarations , deprecation , log-functions }
\ExplSyntaxOff

\begin{document}
\START
\AUTHOR{peaR}
\ExplSyntaxOn

\TEST { Simple~symbolic~comparisons }
  {
    \fp_new_variable:n { a }
    \TYPE { \fp_to_tl:n { a < 5 } }
    \TYPE { \fp_to_tl:n { a = 5 } }
    \TYPE { \fp_to_tl:n { a > 5 } }
    \TYPE { \fp_to_tl:n { a <= 5 } }
    \TYPE { \fp_to_tl:n { a >= 5 } }
    \TYPE { \fp_to_tl:n { a != 5 } }
    \TYPE { \fp_to_tl:n { 5 < a } }
    \TYPE { \fp_to_tl:n { 5 = a } }
    \TYPE { \fp_to_tl:n { 5 > a } }
    \TYPE { \fp_to_tl:n { 5 <= a } }
    \TYPE { \fp_to_tl:n { 5 >= a } }
    \TYPE { \fp_to_tl:n { 5 != a } }
  }

\TEST { Slightly~complex~symbolic~comparisons }
  {
    \fp_new_variable:n { b }
    \TYPE { \fp_to_tl:n { a < b } }
    \TYPE { \fp_to_tl:n { a = b } }
    \TYPE { \fp_to_tl:n { a > b } }
    \TYPE { \fp_to_tl:n { a <= b } }
    \TYPE { \fp_to_tl:n { a >= b } }
    \TYPE { \fp_to_tl:n { a != b } }
    \TYPE { \fp_to_tl:n { a + 1 < b * 2 } }
    \TYPE { \fp_to_tl:n { 2 * a < b - 3 } }
  }

\TEST { Chained~comparisons }
  {
    \fp_new_variable:n { c }
    \TYPE { \fp_to_tl:n { a < b < c } }
    \TYPE { \fp_to_tl:n { 0 < a < 1 } }
    \TYPE { \fp_to_tl:n { a < b > c } }
  }

\TEST { User-defined~functions~with~comparisons }
  {
    \fp_new_function:n { lt }
    \fp_new_function:n { between }
    \fp_new_function:n { ordered }
    \fp_set_function:nnn { lt } { x } { x < 5 }
    \fp_set_function:nnn { between } { x } { 0 < x < 1 }
    \fp_set_function:nnn { ordered } { x , y , z } { x < y < z }
    \TYPE { \fp_to_tl:n { lt(1) } }
    \TYPE { \fp_to_tl:n { between(1/2) } }
    \TYPE { \fp_to_tl:n { ordered(0,3,4) } }
    % NOTE: output might change due to #1730
    \TYPE { \fp_to_tl:n { lt(a) } }
    \TYPE { \fp_to_tl:n { between(a) } }
    \TYPE { \fp_to_tl:n { ordered(a,b,c) } }
  }

\TEST { Logically~false~comparisons }
  {
    \TYPE { \fp_to_tl:n { 2 < 1 < a } }
    \TYPE { \fp_to_tl:n { a < 1 < 0 } }
  }

\TEST { Comparisons~embedded~in~logical~operations }
  {
    \TYPE { \fp_to_tl:n { a < b && b < c } }
    \TYPE { \fp_to_tl:n { a < b || b < c } }
  }

\ExplSyntaxOff
\END